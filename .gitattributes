# Large binaries tracked with Git LFS.
#
# These belong in the repo — the ML model is required to build, the artwork is the
# app's own assets, the reference PDFs are the clinical source material — but they
# are binary and would bloat history if stored inline. LFS keeps pointers in git
# and the blobs out of every clone's object store.
#
# Anything genuinely disposable (build output, archived APKs, unprocessed artwork
# batches) is excluded in .gitignore instead and is not tracked at all.

*.tflite  filter=lfs diff=lfs merge=lfs -text
*.task    filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.webp    filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.pdf     filter=lfs diff=lfs merge=lfs -text

# Text files: normalise line endings so a Windows clone and a CI Linux runner
# agree on file contents.
*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.properties text eol=lf
