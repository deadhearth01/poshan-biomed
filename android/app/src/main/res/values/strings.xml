    <string name="permissions_title">Permissions</string>
    <string name="permissions_subtitle">Here is exactly what we ask for, why, and where it is used. You stay in control.</string>
    <string name="permissions_camera">Camera</string>
    <string name="permissions_camera_why">To watch how your child looks at the screen and how their attention shifts.</string>
    <string name="permissions_camera_use">Used only during the 30-second Attention &amp; Gaze check. Frames are analysed on the phone and never leave it.</string>
    <string name="permissions_notifications">Notifications</string>
    <string name="permissions_notifications_why">To remind you about check-ups, vaccinations and follow-up screening dates.</string>
    <string name="permissions_notifications_use">Used for local reminders only. No promotional messages.</string>
